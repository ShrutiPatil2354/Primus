# Production-scale task memory (leave unset to use local SQLite)
DATABASE_URL=postgresql+psycopg://primus:primus_dev_password@localhost:5432/primus
# Set DATABASE_URL to enable PostgreSQL. Leave unset for local SQLite fallback.

# Multimodal learning artefacts (camera frames, audio, demonstrations)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=primus
MINIO_SECRET_KEY=primus_minio_dev_password
MINIO_BUCKET=primus-learning
MINIO_SECURE=false
